{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pathguard-mcp",
  "main": "src/index.js",
  "compatibility_date": "2026-08-23",
  "compatibility_flags": ["nodejs_compat"],
  "containers": [
    {
      "class_name": "PathGuardContainer",
      "image": "./Dockerfile",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PATHGUARD_CONTAINER",
        "class_name": "PathGuardContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PathGuardContainer"]
    }
  ]
}
